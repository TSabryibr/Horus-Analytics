[flake8]
exclude =
    .git,
    .venv,
    .venv313,
    __pycache__,
    build,
    dist,
    node_modules,
    frontend/node_modules,
    .pytest_cache,
    .ms-playwright,
    .tmp,
    tmp,
    scratch
extend-ignore =
    C901,
    E111,
    E114,
    E117,
    E125,
    E127,
    E128,
    E203,
    E222,
    E225,
    E228,
    E231,
    E251,
    E261,
    E301,
    E302,
    E303,
    E305,
    E306,
    E401,
    E402,
    E501,
    E701,
    E702,
    E712,
    E722,
    E731,
    E741,
    F401,
    F402,
    F403,
    F405,
    F541,
    F811,
    F841,
    W291,
    W293,
    W391
